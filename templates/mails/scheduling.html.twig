<!DOCTYPE html>
<html>
<head>
  <title>Kalendářní oznámení od {{ senderName }}</title>
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
</head>
{% set czech_months = ['ledna', 'února', 'března', 'dubna', 'května', 'června', 'července', 'srpna', 'září', 'října', 'listopadu', 'prosince'] %}
{% set czech_days = ['neděle', 'pondělí', 'úterý', 'středa', 'čtvrtek', 'pátek', 'sobota'] %}
<body leftmargin="0" marginwidth="0" topmargin="0" marginheight="0" offset="0" style="margin: 0; padding: 0; background: #fff; color: #111111; font-family: Arial, sans-serif; font-size: 14px; line-height: 20px;">
<table cellspacing="0" cellpadding="0" width="100%">
  <thead>
    <tr>
      <td colspan="3"> </td>
    </tr>
    <tr>
      <td width="*"> </td>
      <td width="500">
        <table width="100%">
          <tr>
            <td width="1" style="font-size: 64px; font-weight:bold;">{{ dateTime|date('j') }}</td>
            <td width="*" style="padding: 10px 0;">
              <span style=" font-size: 12px; color: #555555">{{ czech_days[dateTime|date('w')] }}</span><br />
              {{ czech_months[dateTime|date('n') - 1] }}
            </td>
            <td width="58" style="text-align: right;">
            </td>
          </tr>
        </table>
      </td>
      <td width="*"> </td>
    </tr>
    <tr>
      <td> </td>
      <td style="border-top: 1px solid #cccccc"> </td>
      <td> </td>
    </tr>
  </thead>

  <tbody>
    <tr>
      <td> </td>
      <td style="text-align: center; padding: 10px 0;">
        {% if action == 'REQUEST' %}
          <strong>{{ senderName }}</strong> vás pozval/a na
          <h1 style="margin: 0; color: #2c7ea9; font-weight: 300; line-height: 36px;">{{ summary }}</h1>
        {% elseif action == 'CANCEL' %}
          <h1 style="margin: 0; color: #2c7ea9; font-weight: 300; line-height: 36px;">{{ summary }}</h1> bylo zrušeno.
        {% elseif action == 'ACCEPTED' %}
          <strong>{{ senderName }}</strong> přijal/a vaše pozvání na
          <h1 style="margin: 0; color: #2c7ea9; font-weight: 300; line-height: 36px;">{{ summary }}</h1>
        {% elseif action == 'TENTATIVE' %}
          <strong>{{ senderName }}</strong> předběžně přijal/a vaše pozvání na
          <h1 style="margin: 0; color: #2c7ea9; font-weight: 300; line-height: 36px;">{{ summary }}</h1>
        {% elseif action == 'DECLINED' %}
          <strong>{{ senderName }}</strong> odmítl/a vaše pozvání na
          <h1 style="margin: 0; color: #2c7ea9; font-weight: 300; line-height: 36px;">{{ summary }}</h1>
        {% endif %}
      </td>
      <td> </td>
    </tr>
    <tr>
      <td colspan="3"> </td>
    </tr>
    <tr>
      <td> </td>
      <td style="border-top: 1px solid #cccccc"> </td>
      <td> </td>
    </tr>
    <tr>
      <td> </td>
      <td>
        <table border="0" cellpadding="0" cellspacing="10" width="100%">
          <tr>
            <td style="vertical-align: bottom; color: #777777;" width="100px">Kdy?</td>
            <td>
              <strong>{{ czech_days[dateTime|date('w')] }}, {{ dateTime|date('j') }}. {{ czech_months[dateTime|date('n') - 1] }} {{ dateTime|date('Y') }}</strong>
            </td>
          </tr>
          {% if not allDay %}
            <tr>
              <td> </td>
              <td><strong>{{ dateTime|date('g:ia T') }}</strong></td>
            </tr>
          {% endif %}
          {% if action != 'CANCEL' %}
            <tr>
              <td style="vertical-align: top; color: #777777;" width="100px">Účastníci:</td>
              <td>
              {% for attendee in attendees %}
                <a href="mailto:{{ attendee.email }}" style="color: #2c7ea9">{{ attendee.email }}</a>
                {% if attendee.role == 'CHAIR' %}(organizátor){% endif %}
                <br />
              {% endfor %}
            </tr>
          {% endif %}
          {% if location %}
          <tr>
            <td style="vertical-align: top; color: #777777;" width="100px">Kde?</td>
            <td>{{ location }}</td>
          </tr>
          {% endif %}
          {% if locationImageDataAsBase64 %}
          <tr>
            <td colspan="2">
                <a href="{{ locationLink }}" title="Navigovat na mapě">
                  <img src="data:image/png;base64,{{ locationImageDataAsBase64 }}" width="100%"/>
                </a>
            </td>
          </tr>
          {% endif %}
          {% if url %}
          <tr>
            <td style="vertical-align: top; color: #777777;" width="100px">URL:</td>
            <td>
              <a href="{{ url }}" style="color: #aaaaaa">{{ url }}</a>
            </td>
          </tr>
          {% endif %}
          {% if description %}
          <tr>
            <td style="vertical-align: top; color: #777777;" width="100px">Poznámky:</td>
            <td>{{ description }}</td>
          </tr>
          {% endif %}
        </table>
      </td>
      <td> </td>
    </tr>

    <tr>
      <td> </td>
      <td style="border-bottom: 1px solid #cccccc"> </td>
      <td> </td>
    </tr>
  </tbody>

  <tfoot>
    <tr>
      <td colspan="3" height="5px"></td>
    </tr>
    <tr>
      <td> </td>
      <td style="font-size: 11px; line-height: 16px; text-align: center; color: #dddddd;">
        E-mail odeslán z {{ app.request.getSchemeAndHttpHost() }}
      </td>
      <td> </td>
    </tr>
  </tfoot>
</table>
</body>
</html>